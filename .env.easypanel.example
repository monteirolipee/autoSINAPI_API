# PostgreSQL
AUTOSINAPI_IMAGE=ghcr.io/SEU_USUARIO/autosinapi-api:main
POSTGRES_DB=sinapi
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Kong/PostgreSQL
KONG_PG_USER=kong
KONG_PG_PASSWORD=troque-por-outra-senha-forte

# Chave compartilhada entre Kong e Estakha.
# Use somente caracteres alfanuméricos, por exemplo: openssl rand -hex 32
ESTAKHA_SINAPI_API_KEY=troque-por-uma-chave-hexadecimal

# API
DATABASE_URL=postgresql+psycopg2://admin:troque-por-uma-senha-forte@db:5432/sinapi
REDIS_HOST=redis
ADMIN_API_TOKEN=troque-por-um-token-administrativo
ALLOWED_ORIGINS=
ETL_STATES=SP
ETL_LOOKBACK_MONTHS=1

# Observabilidade opcional
SENTRY_DSN=
SENTRY_ENV=production
